# Template for local environment variables.
# Copy to `.env` (gitignored) and fill with real values.
# Spring Boot loads `.env` automatically via `spring.config.import`.
# IMPORTANT: No spaces around `=`. Format: KEY=value (not KEY= value).

# ── PostgreSQL ────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5433
DB_NAME=convenia-stagge-db
DB_USER=postgres
DB_PASSWORD=postgres

# ── Cloudflare R2 (S3-compatible storage) ────────────────────────────────────
APP_STORAGE_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
APP_STORAGE_BUCKET=convenia-docs
APP_STORAGE_ACCESS_KEY=<r2-access-key>
APP_STORAGE_SECRET_KEY=<r2-secret-key>

# ── JWT ──────────────────────────────────────────────────────────────────────
# HMAC-SHA-256 key. Generate with: openssl rand -base64 48
APP_JWT_SECRET=<random-256-bit-base64-string>

# ── Documenso API ────────────────────────────────────────────────────────────
DOCUMENSO_TOKEN=api_<your-token>
# DOCUMENSO_WEBHOOK_SECRET=  # optional; required in prod
# DOCUMENSO_TEMPLATE_ID=     # optional; when set, skips PDF generation
